{
  "protocols": {
    "http": false,
    "https": true,
    "socks4": false,
    "socks5": false
  },

  "checker": {
    "dynamic_threads": true,
    "threads": 250,
    "max_threads": 500,
    "save_responses": false,
    "retries": 2,
    "timeout": 7500,
    "checker_timer": {
      "days": 0,
      "hours": 5,
      "minutes": 0,
      "seconds": 0
    },

    "judges_threads": 3,
    "judges_timeout": 5000,
    "judges": [
      {
        "url": "https://pool.proxyspace.pro/judge.php",
        "regex": "default"
      },
      {
        "url": "http://azenv.net",
        "regex": "default"
      }
    ],
    "judge_timer": {
      "days": 0,
      "hours": 1,
      "minutes": 0,
      "seconds": 0
    },

    "use_https_for_socks": true,
    "ip_lookup": "https://ident.me",

    "standard_header": [
      "USER-AGENT", "HOST", "ACCEPT", "ACCEPT-ENCODING"
    ],

    "proxy_header": [
      "HTTP_X_FORWARDED_FOR", "HTTP_FORWARDED", "HTTP_VIA", "HTTP_X_PROXY_ID"
    ]
  },

  "scraper": {
    "dynamic_threads": true,
    "threads": 250,
    "max_threads": 500,
    "retries": 2,
    "timeout": 7500,
    "respect_robots_txt": true,

    "scraper_timer": {
      "days": 0,
      "hours": 10,
      "minutes": 0,
      "seconds": 0
    },

    "scrape_sites": [
    ]
  },

  "proxy_limits": {
    "enabled": false,
    "max_per_user": 1000,
    "exclude_admins": true
  },

  "runtime": {
    "proxy_geo_refresh_timer": {
      "days": 1,
      "hours": 0,
      "minutes": 0,
      "seconds": 0
    }
  },

  "plugins": {
    "geolite": {
      "enabled": false,
      "api_key": "",
      "auto_update": false,
      "update_timer": {
        "days": 1,
        "hours": 0,
        "minutes": 0,
        "seconds": 0
      }
    },
    "abuseipdb": {
      "enabled": false,
      "api_key": "",
      "max_age_in_days": 30,
      "daily_limit": 0,
      "daily_remaining": 0,
      "daily_reset_at": "",
      "last_checked_at": "",
      "last_error": ""
    }
  },

  "blacklist_timer": {
    "days": 0,
    "hours": 6,
    "minutes": 0,
    "seconds": 0
  },
  "blacklist_sources": [
    "https://www.spamhaus.org/drop/drop.txt",
    "http://myip.ms/files/blacklist/general/latest_blacklist.txt"
  ],
  "website_blacklist": []
}
